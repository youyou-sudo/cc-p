# ── Command Code Proxy (Elysia) ────────────────────────────────
# 所有配置优先读取本 .env 文件；未填写的项回退到 config.json / 内置默认值。
# 提示：本文件含敏感密钥，已被 .gitignore 忽略，切勿提交到仓库。

# ── 监听 ────────────────────────────────────────────────────────
# 监听端口（默认 3050）
PORT=3050

# 监听地址（默认 0.0.0.0；本地调试可改 127.0.0.1）
HOST=0.0.0.0

# ── Command Code 上游 ──────────────────────────────────────────
# CC API 地址
CC_API_BASE=https://api.commandcode.ai

# CC API Key（user_ 开头）。留空 = 不启用兜底。
# 填写后：客户端请求未带有效 Authorization: Bearer user_xxx / x-api-key 时，
# 自动使用此 Key 调用上游；客户端带了 Key 则优先用请求里的。
CC_API_KEY=

# CORS 允许来源（默认见下方说明；可为单个 origin 或逗号分隔列表）
# 未填写时的默认行为：
#   - CC_API_KEY 为空（无兜底）：Allow-Origin: *（任意页面可调用，但必须带自己的 Key）
#   - CC_API_KEY 已填写（有兜底）：有 fallback 无显式配置时省略 Allow-Origin（永不发 null），拒绝浏览器跨域，防任意网页无 Key 打额度；
#     仅 curl / SDK 等不带 Origin 的客户端可用
# 显式指定（如 https://app.example.com）可覆盖以上行为。
CORS_ALLOW_ORIGIN=

# ── 日志 ────────────────────────────────────────────────────────
# 日志文件路径（空 = 仅控制台）
LOG_FILE=

# 日志级别（debug / info / warn / error）
LOG_LEVEL=info

# ── 模型列表 ────────────────────────────────────────────────────
# 是否从 Provider API 动态获取模型列表（false 则始终使用内置列表）
CC_USE_PROVIDER_MODELS=true

# 模型列表缓存刷新间隔（毫秒）
CC_MODEL_REFRESH_INTERVAL_MS=300000

# ── 行为开关 ────────────────────────────────────────────────────
# 请求 Command Code 的 ZDR-only 路由（1/true 启用）
CMD_ZDR=true

# ── 请求体上限 ──────────────────────────────────────────────────
# 最大请求体大小（MB），超限返回 HTTP 413（默认 100）
CC_MAX_BODY_MB=100

# ── 空闲超时 ──────────────────────────────────────────────────────
# 上游读空闲上限（毫秒）：流式默认 30000，非流式默认 90000；超限返回 429 retry_after=5；调大可容忍 reasoning 长 prefill/首 token 停顿，但会延长真 hang 占位，按需设置
# Trade-off：调大容忍慢上游、降低小上下文误报，但延迟失败感知（挂起的请求占位更久）；≥3 次连续超时（按 Key 计、TTL 30min）后文案会提示 reduce context，小请求也一样，见 README 排障节
CC_STREAM_IDLE_MS=30000
CC_NONSTREAM_IDLE_MS=90000
# 思考期宽限（毫秒）：lastCcEvent in [start,start-step,reasoning-start,reasoning-delta] 时单次 read 空闲预算改用此值，默认 120000；深度推理/高 reasoning_effort 建议 180000；unset/空/0 回默认，非数字启动报错退出；真 hang 代价是失败感知延迟到该阈值
CC_THINKING_IDLE_MS=120000

# ── 上游韧性（并发门控 + 429 重试）────────────────────────────────
# Key 说明：有效上游 Key = 请求头 user_（Authorization: Bearer / x-api-key）直透，
# 缺失才用 CC_API_KEY 兜底；门控/重试/指纹全部按该 Key 分桶隔离，不混用。
# 每 Key 最大在途上游请求数，超限排队（默认 16）
CC_MAX_CONCURRENCY_PER_KEY=16
# 每 Key 最大排队数，队列满直接 429 retry_after=1（默认 64）
CC_MAX_QUEUE_PER_KEY=64
# 排队等待上限（毫秒），超时 429 retry_after=2（默认 60000）
CC_QUEUE_TIMEOUT_MS=60000
# 上游 429（仅纯 rate_limit 类）最大重试次数，默认 3；
# usage_window_5h/weekly、context_overflow、payment、auth 一律不重试直接透传
CC_RETRY_MAX=3
# 无 Retry-After 时的退避基座（毫秒，1s 起步指数退避+抖动，默认 1000）
CC_RETRY_BASE_MS=1000
# 退避封顶（毫秒，默认 30000）；上游 Retry-After 原样透传给客户端（ceil 到秒），不受此封顶撒谎
CC_RETRY_CAP_MS=30000

# 注：CC_KEY_SELECTION_STRATEGY 已删除（单 Key 模型，该策略不再支持）

# ── 空 system 占位 ─────────────────────────────────────────────────
# 空 system 是否发占位符（1/true 启用，默认 true）
CC_EMPTY_SYSTEM_PLACEHOLDER=true
